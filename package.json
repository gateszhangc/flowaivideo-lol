{
  "name": "flowaivideo-lol",
  "version": "1.0.0",
  "private": true,
  "author": "Flow AI Video",
  "homepage": "https://flowaivideo.lol",
  "repository": {
    "type": "git",
    "url": "https://github.com/gateszhangc/flowaivideo-lol"
  },
  "keywords": [
    "flow-ai-video",
    "ai-video-generator",
    "text-to-video",
    "image-to-video",
    "4k-video",
    "shipany"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx scripts/with-env.ts npx drizzle-kit generate --config=src/core/db/config.ts",
    "db:migrate": "tsx scripts/with-env.ts npx drizzle-kit migrate --config=src/core/db/config.ts",
    "db:push": "tsx scripts/with-env.ts npx drizzle-kit push --config=src/core/db/config.ts",
    "db:studio": "tsx scripts/with-env.ts npx drizzle-kit studio --config=src/core/db/config.ts",
    "auth:generate": "tsx scripts/with-env.ts npx @better-auth/cli generate --config=src/core/auth/index.ts",
    "rbac:init": "tsx scripts/with-env.ts npx tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts npx tsx scripts/assign-role.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv src/shared/types/cloudflare.d.ts",
    "import:reference": "node scripts/flow-reference/import.mjs",
    "build:content": "node scripts/flow-reference/build-content.mjs",
    "check:fidelity": "node scripts/flow-reference/check-fidelity.mjs",
    "brand:assets": "python3 scripts/flow-reference/brand-assets.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@libsql/client": "^0.15.9",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.2",
    "@tabler/icons-react": "^3.34.1",
    "@waffo/pancake-ts": "^0.18.0",
    "better-auth": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "creem": "^0.3.37",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "github-markdown-css": "^5.8.1",
    "lucide-react": "^0.543.0",
    "moment": "^2.30.1",
    "motion": "^12.23.12",
    "mysql2": "^3.16.0",
    "next": "16.0.7",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "overtype": "^1.2.6",
    "postgres": "^3.4.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.62.0",
    "react-use-measure": "^2.1.7",
    "resend": "^6.0.3",
    "rough-notation": "^0.5.1",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  },
  "description": "Flow AI Video (flowaivideo.lol) - English-only AI video generator site built on ai-shipany-template-two-lite"
}
