# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Flow AI Video"
NEXT_PUBLIC_APP_DESCRIPTION = "Flow AI Video is an AI video generator for text to video and image to video creation with 4K cinematic output, multi-shot storytelling and fast rendering."
NEXT_PUBLIC_APP_LOGO = "/logo.svg"
NEXT_PUBLIC_APP_FAVICON = "/favicon.ico"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/og-image.jpg"
NEXT_PUBLIC_DEFAULT_LOCALE = "en"
NEXT_PUBLIC_LOCALE_DETECT_ENABLED = "false"

# analytics
NEXT_PUBLIC_GA_ID = ""

# auth (Google only)
GOOGLE_AUTH_ENABLED = "true"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
EMAIL_AUTH_ENABLED = "false"
GITHUB_AUTH_ENABLED = "false"

# billing (Stripe)
STRIPE_ENABLED = "true"
STRIPE_PUBLISHABLE_KEY = ""
STRIPE_SECRET_KEY = ""
STRIPE_SIGNING_SECRET = ""
STRIPE_PAYMENT_METHODS = '["card"]'
PAYMENT_NOTIFY_EMAIL = "support@flowaivideo.lol"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# Waffo Pancake (leave blank until you are ready to run a test payment)
PANCAKE_ENABLED = "false"
DEFAULT_PAYMENT_PROVIDER = "pancake"
PANCAKE_ENVIRONMENT = "test"
PANCAKE_API_BASE_URL = "https://api.waffo.ai"
PANCAKE_MERCHANT_ID = ""
PANCAKE_STORE_ID = ""
PANCAKE_PRIVATE_KEY = ""
PANCAKE_WEBHOOK_PUBLIC_KEY = ""
PANCAKE_PRODUCT_IDS = '{}'
